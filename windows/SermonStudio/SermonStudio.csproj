<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SermonStudio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>$(MSBuildProjectDirectory)\SermonStudio.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged app. EnableMsixTooling is still required so the build generates
         SermonStudio.pri (compiled XAML + merged WinUI theme resources). Without it
         WinUI cannot resolve ms-appx:/// resources and crashes at startup/first layout. -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PDFsharp-MigraDoc-GDI" Version="6.2.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260209005" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="SermonStudio.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="GenerateSermonStudioIcon" BeforeTargets="PrepareForBuild" Inputs="$(MSBuildProjectDirectory)\GenerateIcon.ps1" Outputs="$(ApplicationIcon)">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\GenerateIcon.ps1&quot; -OutputPath &quot;$(ApplicationIcon)&quot;" />
  </Target>

  <!-- Safety net: make sure the generated resource index always lands in the publish folder. -->
  <Target Name="EnsurePriInPublish" AfterTargets="Publish">
    <ItemGroup>
      <_SermonStudioPri Include="$(OutDir)$(TargetName).pri;$(OutDir)resources.pri" Condition="'$(OutDir)' != ''" />
    </ItemGroup>
    <Copy SourceFiles="@(_SermonStudioPri)" DestinationFolder="$(PublishDir)" Condition="Exists('%(FullPath)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
